{
  "name": "static-site-showcase-workers",
  "version": "1.3.0",
  "private": true,
  "description": "Cloudflare Workers variant of static-site-showcase (Hono + D1 + R2).",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "dev": "npm run sync-assets && wrangler dev",
    "deploy": "npm run sync-assets && wrangler deploy",
    "dry-run": "npm run sync-assets && wrangler deploy --dry-run",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
